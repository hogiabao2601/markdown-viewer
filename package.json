{
  "name": "markdown-viewer",
  "version": "1.0.0",
  "description": "Open a Markdown file as a clean, GitHub-style page in Chrome, with live reload, a raw view and light/dark themes",
  "bin": {
    "md": "bin/md.js"
  },
  "files": [
    "bin",
    "static"
  ],
  "scripts": {
    "test": "node bin/md.js --help"
  },
  "keywords": ["markdown", "viewer", "preview", "cli", "mermaid", "macos"],
  "author": "Bao Ho",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hogiabao2601/markdown-viewer.git"
  },
  "homepage": "https://github.com/hogiabao2601/markdown-viewer#readme",
  "bugs": "https://github.com/hogiabao2601/markdown-viewer/issues",
  "os": ["darwin"],
  "engines": {
    "node": ">=18"
  },
  "type": "commonjs",
  "dependencies": {
    "github-markdown-css": "^5.9.0",
    "highlight.js": "^11.12.0",
    "marked": "^12.0.2",
    "marked-gfm-heading-id": "^3.2.0",
    "mermaid": "^11.17.2"
  }
}
